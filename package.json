{
  "name": "mk-stinger",
  "version": "1.0.0",
  "description": "Browser-based OBS Stinger Transition Generator with WebCodecs and Track Matte WebM export",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\" index.html",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" index.html"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide": "^1.77.0",
    "mediabunny": "^1.66.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.1.0",
    "vitest": "^5.1.1"
  }
}
